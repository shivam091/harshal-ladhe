# reCAPTCHA v3 — get keys from https://www.google.com/recaptcha/admin
# Site key is safe to expose to the browser; the contact page reads it on the server and passes it down as a prop.
RECAPTCHA_SITE_KEY=

# Secret key must NEVER be committed or exposed to the client.
RECAPTCHA_SECRET_KEY=

# reCAPTCHA Enterprise — when both are set, the contact form is checked with an Enterprise assessment instead of
# siteverify, and the assessment's name is stored with each message so the admin can report it as spam or genuine.
# The project is the Google Cloud project the key lives in; the API key (APIs & Services → Credentials) should be
# restricted to the reCAPTCHA Enterprise API.
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=

# MongoDB connection — never commit real credentials.
# Local: mongodb://localhost:27017  |  Atlas: mongodb+srv://<user>:<pass>@<cluster>/...
MONGODB_URI=
MONGODB_DB=

# Local dev only — bypasses SSL cert verification for outbound fetch to Google.
# This variable is NOT set on Vercel, so it has zero effect in production.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ipinfo.io — fallback country lookup when the edge sends no geo header (https://ipinfo.io/account/token).
IPINFO_TOKEN=
