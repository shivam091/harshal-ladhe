# reCAPTCHA v3 — get keys from https://www.google.com/recaptcha/admin
# Site key is safe to expose to the browser; the contact page reads it on the server and passes it down as a prop.
RECAPTCHA_SITE_KEY=

# Secret key must NEVER be committed or exposed to the client.
RECAPTCHA_SECRET_KEY=

# reCAPTCHA Enterprise — when both are set, the contact form is checked with an Enterprise assessment instead of
# siteverify, and the assessment's name is stored with each message so the admin can report it as spam or genuine.
# The project is the Google Cloud project the key lives in; the API key (APIs & Services → Credentials) should be
# restricted to the reCAPTCHA Enterprise API.
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=

# MongoDB connection — never commit real credentials.
# Local: mongodb://localhost:27017  |  Atlas: mongodb+srv://<user>:<pass>@<cluster>/...
MONGODB_URI=
MONGODB_DB=

# Local dev only — bypasses SSL cert verification for outbound fetch to Google.
# This variable is NOT set on Vercel, so it has zero effect in production.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ipinfo.io — fallback country lookup when the edge sends no geo header (https://ipinfo.io/account/token).
IPINFO_TOKEN=

# Keys the hash of a visitor's IP in page_view_seen, which is kept for a year to count unique visitors
# per period. Any long random string (e.g. `openssl rand -hex 32`); changing it starts visitor counting afresh.
VISITOR_HASH_SECRET=

# Sends newsletter_subscribe and contact_submit to Google Analytics from the server (Measurement Protocol), so ad
# blockers can't hide them. GA → Admin → Data streams → the web stream → Measurement Protocol API secrets → Create.
# Server-only: never prefix with NEXT_PUBLIC_. Events are only sent from Vercel production, and skipped with a
# "[ga] ... Skipped" log line when this is empty. Mark both as key events in GA (Admin → Events) once they've arrived.
GA_API_SECRET=

# Brevo — sends the newsletter welcome and the contact form's emails (https://app.brevo.com).
# API key: Brevo → SMTP & API → API Keys → Generate. Server-only: never prefix with NEXT_PUBLIC_.
# When BREVO_API_KEY or MAIL_FROM_EMAIL is empty, emails are skipped with a "[mailer] ... Skipped" log line,
# so local development works without them.
BREVO_API_KEY=

# The sender every email comes from. Must be a verified sender in Brevo (Senders, Domains & Dedicated IPs → Senders),
# or Brevo refuses to send. A Gmail address works but tends to land in spam; an address on a domain you've
# authenticated in Brevo delivers best.
MAIL_FROM_EMAIL=
# Display name beside the address, e.g. "Harshal V. LADHE".
MAIL_FROM_NAME=

# Where new contact-form messages are sent. Falls back to siteConfig.author.email when empty.
MAIL_ADMIN_EMAIL=

# Signs the unsubscribe links in newsletter emails, which open this site's /unsubscribe page. Must be the same value
# as the admin app's credentials mailer.unsubscribe_secret, since its emails link here too (see
# `bin/rails credentials:show --environment production` there); changing it breaks links in emails already sent.
# Any long random string (e.g. `openssl rand -hex 32`). Server-only: never prefix with NEXT_PUBLIC_. When empty, the
# welcome is sent without the link, and unsubscribe links don't work.
UNSUBSCRIBE_SECRET=
